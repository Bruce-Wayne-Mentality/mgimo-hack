# Copy to the server's environment file (never commit real values).
DATABASE_URL=
SESSION_SECRET=
PUBLIC_BASE_URL=

# GigaChat (assistant K4 and «Красная кнопка» stage 2). Leave empty to run without GigaChat.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_API_URL=https://api.giga.chat/v1
# PEM with Russian Trusted Root CA + Sub CA (https://gu-st.ru). TLS verification is never disabled.
GIGACHAT_CA_BUNDLE=
# Embeddings model for the RAG knowledge base: Embeddings (512 tokens, 1024 dims) or EmbeddingsGigaR (4096 tokens, 2560 dims).
# Embeddings are billed separately from chat (402 without a paid package); without them search runs on BM25 only.
GIGACHAT_EMBED_MODEL=Embeddings

# «Красная кнопка»: key directory outside the database and its backups (default: <state-dir>/demo/keys)
REDBUTTON_KEY_DIR=
# cointegrated/rubert-tiny-toxicity ONNX (model.onnx + tokenizer.json); without it only the dictionary runs
TOXICITY_MODEL_DIR=

# Assistant K4: answer rule questions from the knowledge base (RAG). Off = the 15 built-in rules, as before.
# Build the base: pip install -e .[kb] && python -m hse_schedule.cli kb-build (the demo builds it itself when this is on).
RAG_ENABLED=false

# Attachments in chats (requests and the red button)
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_MB=10
# Outside public static files; serve defaults it to <state-dir>/<demo|live>/attachments
ATTACHMENTS_DIR=
